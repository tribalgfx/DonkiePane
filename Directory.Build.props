<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>DonkiePane</Company>
    <Product>DonkiePane</Product>
    <Copyright>Copyright (C) 2026 tribalgfx. GPL-3.0-or-later.</Copyright>
    <Version>0.4.1</Version>
  </PropertyGroup>

  <!-- Vertalen (Loc.T("Nederlandse tekst")) kan in elk project zonder extra using. -->
  <ItemGroup>
    <Using Include="DonkiePane.Core.Loc" Alias="Loc" />
  </ItemGroup>

  <!--
    Een Release-build is wat gebruikers krijgen. Zonder dit staat het pad van de bouwmap (met de naam van wie
    bouwde) in elke DLL en elk .pdb-bestand. Met PathMap wordt dat /_/; de stacktraces blijven bruikbaar.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
