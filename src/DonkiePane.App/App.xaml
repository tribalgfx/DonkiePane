<Application x:Class="DonkiePane.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Theedoek-kleuren; later uitbreidbaar tot thema's. -->
        <SolidColorBrush x:Key="PaneBackground" Color="#B3201A1A" />
        <SolidColorBrush x:Key="PaneTitleBackground" Color="#CCB3262D" />
        <SolidColorBrush x:Key="PaneBorder" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="PaneText" Color="#FFF5F0E8" />
        <SolidColorBrush x:Key="PaneMutedText" Color="#A6F5F0E8" />
        <SolidColorBrush x:Key="PaneInputBackground" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="PaneAccent" Color="#FFF2C14E" />
        <SolidColorBrush x:Key="PaneOverdue" Color="#FFFF9A8A" />

        <!-- Standaardwaarden; elke pane overschrijft deze met zijn thema (zie PaneThemes). -->
        <SolidColorBrush x:Key="PaneCheck" Color="#FFB3262D" />

        <!-- Vinkje: afgerond vierkantje dat de themakleur krijgt als het aan staat. -->
        <Style TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                BorderThickness="1.5" BorderBrush="#99F5F0E8" Background="Transparent">
                            <TextBlock x:Name="Mark" Text="✓" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FFF5F0E8" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFF5F0E8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PaneCheck}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PaneCheck}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dunne scrollbalk. -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Margin="2,0" CornerRadius="3" Background="#55F5F0E8" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#99F5F0E8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Voltooid"-kop: pijltje en tekst, zonder de witte cirkel van Windows. -->
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock x:Name="Arrow" Text="▸" Width="16" VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="▾" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,4,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PaneInputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PaneText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PaneText}" />
            <Setter Property="SelectionBrush" Value="#FFB3262D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
    </Application.Resources>
</Application>
