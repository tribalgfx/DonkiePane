<Window x:Class="DonkiePane.App.ListPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kies een Google Taken-lijst"
        Width="380" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF201A1A"
        Foreground="#FFF5F0E8"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="#FFF5F0E8" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Welke lijst wil je in dit pane tonen? De lijst blijft bij Google staan; als je het pane later verwijdert, blijven je taken bewaard." />

        <ListBox x:Name="Lists" Grid.Row="1"
                 Background="#26FFFFFF" BorderThickness="0" Foreground="#FFF5F0E8"
                 DisplayMemberPath="Title"
                 MouseDoubleClick="Lists_MouseDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Kiezen" IsDefault="True" Width="90" Padding="0,6" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Annuleren" IsCancel="True" Width="90" Padding="0,6" />
        </StackPanel>
    </Grid>
</Window>
