<Window x:Class="DonkiePane.App.PaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        MinWidth="160" MinHeight="36">
    <Border x:Name="Frame"
            Background="{DynamicResource PaneBackground}"
            BorderBrush="{DynamicResource PaneBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Triggers>
            <!-- De knoppen in de kop verschijnen pas als je met de muis boven het pane komt. -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titelbalk: slepen verplaatst, dubbelklik rolt op/uit. -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource PaneTitleBackground}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Naam wijzigen" Click="Rename_Click" />
                        <MenuItem x:Name="ThemeMenu" Header="Thema">
                            <!-- De themakleuren komen hier bovenin (zie BuildThemeMenu). -->
                            <Separator x:Name="ThemeSeparator" />
                            <MenuItem Header="Eigen kleur kiezen…" Click="PickColor_Click" />
                            <MenuItem x:Name="TransparencyMenu" Header="Transparantie" />
                            <MenuItem x:Name="PatternMenuItem" Header="Ruitpatroon" IsCheckable="True" Click="Pattern_Click" />
                            <Separator />
                            <MenuItem Header="Standaard herstellen" Click="ResetLook_Click" />
                        </MenuItem>
                        <MenuItem x:Name="DeleteMenuItem" Header="Pane verwijderen" Click="Delete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="12,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PaneTitleText}"
                                   FontFamily="{DynamicResource UiDisplayFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- Aantal iconen, gedempt naast de titel (alleen bij iconenpanes). -->
                        <TextBlock x:Name="CountText"
                                   Margin="8,1,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource PaneTitleText}"
                                   Opacity="0.55"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="TitleEditor"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="-5,0,6,0"
                             FontWeight="SemiBold"
                             Style="{DynamicResource PaneTextBox}"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />

                    <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Opacity="0" VerticalAlignment="Center">
                        <Button x:Name="RollButton" Style="{DynamicResource GlyphButton}" Click="Roll_Click"
                                Foreground="{DynamicResource PaneTitleText}" ToolTip="Oprollen" Content="&#xE70E;" FontSize="10" />
                        <Button x:Name="MenuButton" Style="{DynamicResource GlyphButton}" Click="Menu_Click"
                                Foreground="{DynamicResource PaneTitleText}" ToolTip="Opties" Content="&#xE712;" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Divider" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PaneDivider}" />

            <!-- Inhoud: iconen of taken. -->
            <ContentControl x:Name="Body" Grid.Row="1" Focusable="False" />
        </Grid>
    </Border>
</Window>
