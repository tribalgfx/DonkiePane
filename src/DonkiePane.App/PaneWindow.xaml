<Window x:Class="DonkiePane.App.PaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="160" MinHeight="36">
    <Border Background="{DynamicResource PaneBackground}"
            BorderBrush="{DynamicResource PaneBorder}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titelbalk: slepen verplaatst, dubbelklik rolt op/uit. -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource PaneTitleBackground}"
                    CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Naam wijzigen" Click="Rename_Click" />
                        <MenuItem x:Name="ThemeMenu" Header="Thema" />
                        <MenuItem x:Name="DeleteMenuItem" Header="Pane verwijderen" Click="Delete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,0">
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PaneText}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                </Grid>
            </Border>

            <!-- Inhoud: iconen of taken. -->
            <ContentControl x:Name="Body" Grid.Row="1" Focusable="False" />
        </Grid>
    </Border>
</Window>
