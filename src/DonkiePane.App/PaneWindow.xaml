<Window x:Class="DonkiePane.App.PaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DonkiePane.App"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="160" MinHeight="36">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="3" ShadowDepth="1" Opacity="0.8" />

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type local:ItemView}">
            <Border x:Name="Tile"
                    Width="84" Margin="2" Padding="4,6,4,4"
                    CornerRadius="4"
                    Background="Transparent"
                    ToolTip="{Binding DisplayName}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseMove="Tile_MouseMove">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Openen" FontWeight="Bold" Click="OpenItem_Click" />
                        <MenuItem Header="Bestandslocatie openen" Click="ShowInExplorer_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="48" Height="48"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}"
                               Margin="0,4,0,0"
                               MaxHeight="32"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               Foreground="{StaticResource PaneText}"
                               Effect="{StaticResource TextShadow}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#33FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource PaneBackground}"
            BorderBrush="{StaticResource PaneBorder}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titelbalk: slepen verplaatst, dubbelklik rolt op/uit. -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource PaneTitleBackground}"
                    CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Naam wijzigen" Click="Rename_Click" />
                        <MenuItem x:Name="DeleteMenuItem" Header="Pane verwijderen" Click="Delete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,0">
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PaneText}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                </Grid>
            </Border>

            <!-- Inhoud: iconen; ook het doel bij slepen. -->
            <Grid x:Name="Body" Grid.Row="1" Background="Transparent" AllowDrop="True"
                  DragOver="Body_DragOver" Drop="Body_Drop">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsHost" Margin="4" ItemTemplate="{StaticResource ItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Margin="12"
                           Foreground="{StaticResource PaneText}"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"
                           Text="Sleep hier iconen naartoe." />
            </Grid>
        </Grid>
    </Border>
</Window>
