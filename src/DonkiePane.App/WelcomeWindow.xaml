<Window x:Class="DonkiePane.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welkom bij DonkiePane"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF201A1A"
        Foreground="#FFF5F0E8"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A6F5F0E8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF5F0E8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="26,2,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#FFF5F0E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#26FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FFC82D35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Welkom bij DonkiePane" />
        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                   Text="Vakken (panes) op je bureaublad voor je snelkoppelingen en je taken." />

        <TextBlock Style="{StaticResource Heading}" Text="Je bureaubladiconen" />
        <TextBlock Foreground="{StaticResource Muted}"
                   Text="DonkiePane zet de iconen van je bureaublad in een pane met de naam Inbox. Je bestanden blijven precies waar ze staan: uit zichzelf verplaatst of verwijdert DonkiePane niets. Je kunt ze daarna over eigen panes verdelen, en alles doen wat je op het bureaublad ook doet (slepen, Delete, F2, kopiëren en plakken)." />
        <CheckBox x:Name="HideIconsBox" Style="{StaticResource Option}" IsChecked="True">
            <TextBlock Text="Windows-bureaubladiconen verbergen" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Anders zie je ze dubbel. Het kan altijd weer aan in Instellingen, of met rechtsklikken op het bureaublad → Beeld → Bureaubladpictogrammen weergeven." />

        <CheckBox x:Name="AutoStartBox" Style="{StaticResource Option}">
            <TextBlock Text="DonkiePane starten met Windows" />
        </CheckBox>

        <TextBlock Style="{StaticResource Heading}" Text="Handig om te weten" />
        <TextBlock Margin="0,0,0,4" Text="• Het DonkiePane-icoon bij de klok: nieuw pane, instellingen en afsluiten." />
        <TextBlock Margin="0,0,0,4" Text="• Rechtsklik op een titelbalk: naam, thema, kleur en transparantie van dat pane." />
        <TextBlock Margin="0,0,0,4" Text="• Dubbelklik op een leeg stuk bureaublad: alle panes verbergen of weer tonen." />
        <TextBlock Text="• Taken kunnen lokaal blijven of met een bron synchroniseren (Google Taken, Home Assistant of een eigen dienst)." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SourcesButton" Style="{StaticResource Action}" Content="Takenbron toevoegen…" Click="Sources_Click" />
            <Button Style="{StaticResource Action}" Content="Aan de slag" IsDefault="True" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
</Window>
