<UserControl x:Class="DonkiePane.App.IconsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DonkiePane.App"
             xmlns:local="clr-namespace:DonkiePane.App">
    <UserControl.Resources>

        <!-- Rechtermuisknop toont het menu van Verkenner; dit is alleen de terugval als dat niet lukt. -->
        <ContextMenu x:Key="FallbackMenu" x:Shared="False">
            <MenuItem Header="{l:T 'Openen'}" FontWeight="SemiBold" Click="OpenItem_Click" />
            <MenuItem Header="{l:T 'Bestandslocatie openen'}" Click="ShowInExplorer_Click" />
        </ContextMenu>

        <!-- Hoe de iconen naast elkaar staan: in rijen (grote en kleine iconen) of onder elkaar (lijst). -->
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListItems">
            <StackPanel />
        </ItemsPanelTemplate>

        <!--
            Eén icoon: zoals op het bureaublad, met een afgeronde markering bij aanwijzen en selecteren.
            De weergave van het pane (IconsView.Mode, IconPixels, TileWidth en ShowNames; ze erven door naar elk icoon)
            bepaalt de maat: groot, klein of een lijstregel met het icoon links van de naam.
        -->
        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile"
                                Width="{Binding (local:IconsView.TileWidth), RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="4,7,4,6"
                                CornerRadius="7"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                ToolTip="{Binding DisplayName}"
                                ToolTipService.InitialShowDelay="900">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image x:Name="Icon" Grid.ColumnSpan="2" Source="{Binding Icon}"
                                       Width="{Binding (local:IconsView.IconPixels), RelativeSource={RelativeSource TemplatedParent}}"
                                       Height="{Binding (local:IconsView.IconPixels), RelativeSource={RelativeSource TemplatedParent}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Grid x:Name="NameArea" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                    <TextBlock x:Name="NameText"
                                               Text="{Binding DisplayName}"
                                               MaxHeight="32"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12"
                                               LineHeight="16"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{DynamicResource PaneText}"
                                               Effect="{DynamicResource PaneTextShadow}" />
                                    <TextBox x:Name="NameEditor"
                                             Visibility="Collapsed"
                                             TextAlignment="Center"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             MaxLength="255"
                                             FontSize="12"
                                             Padding="2,1"
                                             Style="{DynamicResource PaneTextBox}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:IconsView.Mode" Value="Small">
                                <Setter TargetName="Tile" Property="Padding" Value="2,5,2,4" />
                                <Setter TargetName="NameArea" Property="Margin" Value="0,4,0,0" />
                                <Setter TargetName="NameText" Property="FontSize" Value="11" />
                                <Setter TargetName="NameText" Property="LineHeight" Value="14" />
                                <Setter TargetName="NameText" Property="MaxHeight" Value="28" />
                                <Setter TargetName="NameEditor" Property="FontSize" Value="11" />
                            </Trigger>
                            <Trigger Property="local:IconsView.Mode" Value="List">
                                <Setter TargetName="Tile" Property="Width" Value="NaN" />
                                <Setter TargetName="Tile" Property="Padding" Value="6,3" />
                                <Setter TargetName="Tile" Property="CornerRadius" Value="5" />
                                <Setter TargetName="Icon" Property="Grid.ColumnSpan" Value="1" />
                                <Setter TargetName="NameArea" Property="Grid.Row" Value="0" />
                                <Setter TargetName="NameArea" Property="Grid.Column" Value="1" />
                                <Setter TargetName="NameArea" Property="Grid.ColumnSpan" Value="1" />
                                <Setter TargetName="NameArea" Property="Margin" Value="8,0,0,0" />
                                <Setter TargetName="NameArea" Property="VerticalAlignment" Value="Center" />
                                <Setter TargetName="NameText" Property="TextAlignment" Value="Left" />
                                <Setter TargetName="NameText" Property="TextWrapping" Value="NoWrap" />
                                <Setter TargetName="NameEditor" Property="TextAlignment" Value="Left" />
                                <Setter TargetName="NameEditor" Property="TextWrapping" Value="NoWrap" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource PaneHover}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PaneHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource PaneSelection}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PaneSelectionBorder}" />
                                <!-- Zoals op het bureaublad: geselecteerd staat de hele naam er, niet afgekapt na twee regels. -->
                                <Setter TargetName="NameText" Property="MaxHeight" Value="Infinity" />
                            </Trigger>
                            <!-- Pane niet actief: de selectie blijft, maar gedempt (zoals in Verkenner). -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource PaneHover}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PaneSelectionInactiveBorder}" />
                            </MultiTrigger>
                            <!-- Bestanden zweven boven een map, de Prullenbak of een programma: daar neerzetten. -->
                            <Trigger Property="Tag" Value="DropTarget">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource PaneSelection}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PaneAccentLine}" />
                            </Trigger>
                            <!-- Namen verborgen (instelling van het pane): alleen het icoon, de naam komt sneller in de tooltip. -->
                            <Trigger Property="local:IconsView.ShowNames" Value="False">
                                <Setter TargetName="NameArea" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Tile" Property="ToolTipService.InitialShowDelay" Value="300" />
                            </Trigger>
                            <!-- Lang niet geopend (Instellingen → Panes): grijs en wat lichter, de naam blijft leesbaar. -->
                            <Trigger Property="local:IconsView.IsDimmed" Value="True">
                                <Setter TargetName="Icon" Property="Source" Value="{Binding GrayIcon}" />
                                <Setter TargetName="Icon" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <!-- Geknipt (Ctrl+X): half doorzichtig tot het geplakt is, zoals in Verkenner. -->
                            <Trigger Property="local:IconsView.IsCut" Value="True">
                                <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="local:IconsView.Mode" Value="List">
                    <Setter Property="Margin" Value="0,1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
          DragEnter="Root_DragEnter" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop"
          PreviewMouseMove="Root_PreviewMouseMove" PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
          LostMouseCapture="Root_LostMouseCapture">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Snel filteren: verschijnt zodra je in het pane begint te typen (of met Ctrl+F). -->
        <Border x:Name="FilterBar" Visibility="Collapsed" Margin="8,7,8,1" Padding="7,0,2,0" CornerRadius="5"
                Background="{DynamicResource PaneHover}" BorderBrush="{DynamicResource PaneHoverBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource PaneMutedText}" />
                <TextBox x:Name="FilterBox" Grid.Column="1" Margin="4,0,0,0" BorderThickness="0" Background="Transparent"
                         Style="{DynamicResource PaneTextBox}"
                         TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"
                         LostKeyboardFocus="FilterBox_LostKeyboardFocus" />
                <Button Grid.Column="2" Style="{DynamicResource GlyphButton}" Foreground="{DynamicResource PaneMutedText}"
                        Content="&#xE711;" FontSize="9" ToolTip="{l:T 'Filter wissen (Esc)'}" Click="ClearFilter_Click" />
            </Grid>
        </Border>

        <ListBox x:Name="ItemsHost"
                 Grid.Row="1"
                 SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource TileStyle}"
                 ItemsPanel="{StaticResource WrapItems}"
                 IsTextSearchEnabled="False"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 FocusVisualStyle="{x:Null}"
                 PreviewMouseLeftButtonDown="ItemsHost_PreviewMouseLeftButtonDown"
                 PreviewMouseRightButtonDown="ItemsHost_PreviewMouseRightButtonDown"
                 MouseRightButtonUp="ItemsHost_MouseRightButtonUp"
                 PreviewKeyDown="ItemsHost_PreviewKeyDown"
                 PreviewTextInput="ItemsHost_PreviewTextInput"
                 SelectionChanged="ItemsHost_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="Scroller" Focusable="False" Padding="6,6,6,10"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>

        <!-- Selectiekader en de plek waar gesleepte iconen komen. -->
        <Canvas x:Name="Overlay" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="Marquee" Visibility="Collapsed" CornerRadius="3" BorderThickness="1"
                    Background="{DynamicResource PaneSelection}" BorderBrush="{DynamicResource PaneAccentLine}" />
            <Border x:Name="InsertMarker" Visibility="Collapsed" Width="3" CornerRadius="1.5"
                    Background="{DynamicResource PaneAccentLine}" />
        </Canvas>

        <TextBlock x:Name="NoMatchHint" Grid.Row="1" Visibility="Collapsed" Margin="16" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Opacity="0.8"
                   Foreground="{DynamicResource PaneMutedText}" Text="{l:T 'Geen iconen gevonden'}" />

        <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                    IsHitTestVisible="False" Opacity="0.7">
            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="26"
                       HorizontalAlignment="Center" Foreground="{DynamicResource PaneMutedText}" />
            <TextBlock x:Name="EmptyHintText" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource PaneMutedText}"
                       Text="{l:T 'Sleep hier iconen of bestanden naartoe'}" />
        </StackPanel>
    </Grid>
</UserControl>
