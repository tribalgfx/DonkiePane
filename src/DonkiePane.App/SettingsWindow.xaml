<Window x:Class="DonkiePane.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DonkiePane.App"
        Title="{l:T 'DonkiePane – Instellingen'}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF201A1A"
        Foreground="#FFF5F0E8"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A6F5F0E8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF5F0E8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="26,2,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Foreground" Value="#FFF5F0E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#26FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Keuze uit een paar opties (taal): de gekozen optie licht op. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Foreground" Value="#FFF5F0E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,12,24,24">
        <TextBlock Style="{StaticResource Heading}" Margin="0,6,0,6" Text="{l:T 'Bureaublad'}" />

        <CheckBox x:Name="HideIconsBox" Style="{StaticResource Option}" Click="HideIcons_Click">
            <TextBlock Text="{l:T 'Windows-bureaubladiconen verbergen'}" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="{l:T 'DonkiePane toont je iconen in panes. Je bestanden blijven gewoon op je bureaublad staan. Uitgezet zie je de Windows-iconen weer.'}" />

        <CheckBox x:Name="DoubleClickBox" Style="{StaticResource Option}" Click="DoubleClick_Click">
            <TextBlock Text="{l:T 'Dubbelklikken op het bureaublad verbergt de panes'}" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="{l:T 'Dubbelklik op een leeg stuk bureaublad om alle panes met hun inhoud te verbergen, en nog een keer om ze terug te halen.'}" />

        <CheckBox x:Name="AutoStartBox" Style="{StaticResource Option}" Click="AutoStart_Click">
            <TextBlock Text="{l:T 'Starten met Windows'}" />
        </CheckBox>
        <TextBlock x:Name="AutoStartHint" Style="{StaticResource Hint}" />

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Panes'}" />
        <TextBlock Text="{l:T 'Uiterlijk'}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AppearanceDark" Style="{StaticResource Chip}" GroupName="Appearance" Checked="Appearance_Checked" Content="{l:T 'Donker'}" />
            <RadioButton x:Name="AppearanceLight" Style="{StaticResource Chip}" GroupName="Appearance" Checked="Appearance_Checked" Content="{l:T 'Licht'}" />
            <RadioButton x:Name="AppearanceSystem" Style="{StaticResource Chip}" GroupName="Appearance" Checked="Appearance_Checked" Content="{l:T 'Zoals Windows'}" />
        </StackPanel>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{l:T 'Ronde hoeken'}" />
            <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="20"
                    TickFrequency="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="CornerSlider_ValueChanged" />
            <TextBlock x:Name="CornerValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Text="{l:T 'Kleur, transparantie en Mica kies je per pane: rechtsklik op de titelbalk → Thema.'}" />

        <TextBlock Margin="0,14,0,0" Text="{l:T 'Een opgerold pane openen'}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RollButtonOnly" Style="{StaticResource Chip}" GroupName="RollUp" Checked="RollUp_Checked" Content="{l:T 'Met de knop'}" />
            <RadioButton x:Name="RollHover" Style="{StaticResource Chip}" GroupName="RollUp" Checked="RollUp_Checked" Content="{l:T 'Bij aanwijzen'}" />
            <RadioButton x:Name="RollClick" Style="{StaticResource Chip}" GroupName="RollUp" Checked="RollUp_Checked" Content="{l:T 'Met een klik'}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Text="{l:T 'Bij aanwijzen of een klik gaat een opgerold pane even open en rolt het weer op als de muis weggaat. Dubbelklikken op de titelbalk rolt het echt uit.'}" />

        <TextBlock Margin="0,14,0,0" Text="{l:T 'Sneltoets om de panes naar voren te halen'}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,4"
                     Background="#26FFFFFF" Foreground="#FFF5F0E8" BorderThickness="0"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
            <Button Style="{StaticResource Action}" Margin="8,0,0,0" Click="ClearHotkey_Click" Content="{l:T 'Geen'}" />
        </StackPanel>
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Ruitjesraster'}" />

        <CheckBox x:Name="SnapBox" Style="{StaticResource Option}" Click="Snap_Click">
            <TextBlock Text="{l:T 'Panes vastklikken op het raster'}" />
        </CheckBox>
        <Grid Margin="26,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{l:T 'Rastergrootte'}" />
            <Slider x:Name="GridSlider" Grid.Column="1" Minimum="16" Maximum="64"
                    TickFrequency="8" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="GridSlider_ValueChanged" />
            <TextBlock x:Name="GridValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Synchronisatie'}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                   Text="{l:T 'Hoe vaak DonkiePane kijkt of er op een ander apparaat iets is veranderd. Wijzigingen die je in DonkiePane maakt, gaan direct weg.'}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{l:T 'Controleren elke'}" />
            <Slider x:Name="SyncSlider" Grid.Column="1" Minimum="15" Maximum="300"
                    TickFrequency="15" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="SyncSlider_ValueChanged" />
            <TextBlock x:Name="SyncValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Taken'}" />
        <CheckBox x:Name="RemindDueBox" Style="{StaticResource Option}" Margin="0,2,0,0" Click="RemindDue_Click">
            <TextBlock Text="{l:T 'Melding bij taken met een deadline van vandaag'}" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="{l:T 'Kort na het starten en daarna elk kwartier kijkt DonkiePane in je takenpanes. Over elke taak krijg je hooguit één melding per dag.'}" />

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Takenbronnen'}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="{l:T 'Waar een takenpane zijn taken vandaan haalt. Lokale taken werken altijd. Andere bronnen voeg je zelf toe: elke bron heeft zijn eigen gegevens, en tokens worden versleuteld op deze pc bewaard.'}" />
        <ListBox x:Name="SourcesList" Height="96" Background="#26FFFFFF" BorderThickness="0" Foreground="#FFF5F0E8"
                 DisplayMemberPath="Label" SelectionChanged="Sources_SelectionChanged" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="AddSource_Click" Content="{l:T 'Toevoegen…'}" />
            <Button x:Name="EditSourceButton" Style="{StaticResource Action}" Click="EditSource_Click" Content="{l:T 'Bewerken…'}" />
            <Button x:Name="RemoveSourceButton" Style="{StaticResource Action}" Click="RemoveSource_Click" Content="{l:T 'Verwijderen'}" />
        </StackPanel>
        <TextBlock x:Name="PluginsInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" />

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Regels'}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="{l:T 'Nieuwe bestanden op het bureaublad gaan naar het pane van de eerste regel die past, in plaats van naar de Inbox. Plak of sleep je iets zelf in een pane, dan blijft het daar.'}" />
        <ListBox x:Name="RulesList" Height="96" Background="#26FFFFFF" BorderThickness="0" Foreground="#FFF5F0E8"
                 DisplayMemberPath="Label" SelectionChanged="Rules_SelectionChanged" MouseDoubleClick="EditRule_Click" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="AddRule_Click" Content="{l:T 'Toevoegen…'}" />
            <Button x:Name="EditRuleButton" Style="{StaticResource Action}" Click="EditRule_Click" Content="{l:T 'Bewerken…'}" />
            <Button x:Name="RemoveRuleButton" Style="{StaticResource Action}" Click="RemoveRule_Click" Content="{l:T 'Verwijderen'}" />
            <Button x:Name="RuleUpButton" Style="{StaticResource Action}" Click="RuleUp_Click" Content="&#xE70E;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{l:T 'Hoger (gaat voor)'}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ApplyRulesButton" Style="{StaticResource Action}" Click="ApplyRules_Click" Content="{l:T 'Nu toepassen op de Inbox'}" />
        </StackPanel>
        <TextBlock x:Name="RulesStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Schermen'}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0" Foreground="{StaticResource Muted}"
                   Text="{l:T 'Valt een scherm weg, dan haalt DonkiePane de panes vanzelf terug en zet ze weer op hun plek zodra het scherm terugkomt. Is er toch iets zoek, haal dan alles naar je hoofdscherm.'}" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="BringPanes_Click" Content="{l:T 'Alle panes naar hoofdscherm'}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Gegevens'}" />
        <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="OpenData_Click" Content="{l:T 'Map openen'}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                   Text="{l:T 'Bewaar je panes en hun plek als bestand, bijvoorbeeld als reservekopie of om ze op een andere pc over te zetten. Taken, bronnen en tokens gaan niet mee.'}" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ExportButton" Style="{StaticResource Action}" Click="ExportLayout_Click" Content="{l:T 'Indeling exporteren…'}" />
            <Button x:Name="ImportButton" Style="{StaticResource Action}" Click="ImportLayout_Click" Content="{l:T 'Indeling importeren…'}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Taal'}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="LanguageAuto" Style="{StaticResource Chip}" GroupName="Language" Checked="Language_Checked"
                         Content="{l:T 'Zoals Windows'}" />
            <RadioButton x:Name="LanguageDutch" Style="{StaticResource Chip}" GroupName="Language" Checked="Language_Checked" />
            <RadioButton x:Name="LanguageEnglish" Style="{StaticResource Chip}" GroupName="Language" Checked="Language_Checked" />
        </StackPanel>
        <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="{l:T 'De nieuwe taal geldt na het opnieuw starten van DonkiePane.'}" />
        <StackPanel x:Name="RestartPanel" Orientation="Horizontal" Visibility="Collapsed">
            <Button Style="{StaticResource Action}" Click="Restart_Click" Content="{l:T 'Nu opnieuw starten'}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="{l:T 'Updates'}" />
        <CheckBox x:Name="UpdatesBox" Style="{StaticResource Option}" Click="Updates_Click">
            <TextBlock Text="{l:T 'Automatisch kijken of er een nieuwe versie is'}" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="{l:T 'Kort na het starten en daarna eens per dag kijkt DonkiePane op GitHub. Is er een nieuwe versie, dan krijg je een melding; installeren gebeurt pas als jij op Nu bijwerken klikt.'}" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="CheckNowButton" Style="{StaticResource Action}" Click="CheckNow_Click" Content="{l:T 'Nu controleren'}" />
            <Button x:Name="ShowUpdateButton" Style="{StaticResource Action}" Click="ShowUpdate_Click" Content="{l:T 'Bijwerken…'}" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />

        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,22,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>

