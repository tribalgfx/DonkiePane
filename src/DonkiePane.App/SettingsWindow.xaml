<Window x:Class="DonkiePane.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DonkiePane – Instellingen"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF201A1A"
        Foreground="#FFF5F0E8"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A6F5F0E8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF5F0E8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="26,2,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Foreground" Value="#FFF5F0E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#26FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,12,24,24">
        <TextBlock Style="{StaticResource Heading}" Margin="0,6,0,6" Text="Bureaublad" />

        <CheckBox x:Name="HideIconsBox" Style="{StaticResource Option}" Click="HideIcons_Click">
            <TextBlock Text="Windows-bureaubladiconen verbergen" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="DonkiePane toont je iconen in panes. Je bestanden blijven gewoon op je bureaublad staan. Uitgezet zie je de Windows-iconen weer." />

        <CheckBox x:Name="DoubleClickBox" Style="{StaticResource Option}" Click="DoubleClick_Click">
            <TextBlock Text="Dubbelklikken op het bureaublad verbergt de panes" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Dubbelklik op een leeg stuk bureaublad om alle panes met hun inhoud te verbergen, en nog een keer om ze terug te halen." />

        <CheckBox x:Name="AutoStartBox" Style="{StaticResource Option}" Click="AutoStart_Click">
            <TextBlock Text="Starten met Windows" />
        </CheckBox>
        <TextBlock x:Name="AutoStartHint" Style="{StaticResource Hint}" />

        <TextBlock Style="{StaticResource Heading}" Text="Ruitjesraster" />

        <CheckBox x:Name="SnapBox" Style="{StaticResource Option}" Click="Snap_Click">
            <TextBlock Text="Panes vastklikken op het raster" />
        </CheckBox>
        <Grid Margin="26,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="Rastergrootte" />
            <Slider x:Name="GridSlider" Grid.Column="1" Minimum="16" Maximum="64"
                    TickFrequency="8" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="GridSlider_ValueChanged" />
            <TextBlock x:Name="GridValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="Synchronisatie" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                   Text="Hoe vaak DonkiePane kijkt of er op een ander apparaat iets is veranderd. Wijzigingen die je in DonkiePane maakt, gaan direct weg." />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="Controleren elke" />
            <Slider x:Name="SyncSlider" Grid.Column="1" Minimum="15" Maximum="300"
                    TickFrequency="15" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="SyncSlider_ValueChanged" />
            <TextBlock x:Name="SyncValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="Takenbronnen" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="Waar een takenpane zijn taken vandaan haalt. Lokale taken werken altijd. Andere bronnen voeg je zelf toe: elke bron heeft zijn eigen gegevens, en tokens worden versleuteld op deze pc bewaard." />
        <ListBox x:Name="SourcesList" Height="96" Background="#26FFFFFF" BorderThickness="0" Foreground="#FFF5F0E8"
                 DisplayMemberPath="Label" SelectionChanged="Sources_SelectionChanged" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="AddSource_Click" Content="Toevoegen…" />
            <Button x:Name="EditSourceButton" Style="{StaticResource Action}" Click="EditSource_Click" Content="Bewerken…" />
            <Button x:Name="RemoveSourceButton" Style="{StaticResource Action}" Click="RemoveSource_Click" Content="Verwijderen" />
        </StackPanel>
        <TextBlock x:Name="PluginsInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" />

        <TextBlock Style="{StaticResource Heading}" Text="Schermen" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0" Foreground="{StaticResource Muted}"
                   Text="Valt een scherm weg, dan haalt DonkiePane de panes vanzelf terug en zet ze weer op hun plek zodra het scherm terugkomt. Is er toch iets zoek, haal dan alles naar je hoofdscherm." />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="BringPanes_Click" Content="Alle panes naar hoofdscherm" />
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="Gegevens" />
        <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" Click="OpenData_Click" Content="Map openen" />
        </StackPanel>

        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,22,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>

