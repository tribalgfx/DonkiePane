<UserControl x:Class="DonkiePane.App.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DonkiePane.App"
             xmlns:local="clr-namespace:DonkiePane.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Ster: belangrijk aan/uit. -->
        <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="ToolTip" Value="{l:T 'Belangrijk'}" />
        </Style>

        <!-- x:Shared="False": elke taak krijgt een eigen menu. -->
        <ContextMenu x:Key="TaskMenu" x:Shared="False">
            <MenuItem Header="{l:T 'Belangrijk'}" IsCheckable="True" IsChecked="{Binding IsImportant, Mode=OneWay}" Click="ToggleImportant_Click"
                      Visibility="{Binding ShowStar, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{l:T 'Naam wijzigen'}" Click="Edit_Click" />
            <MenuItem Header="{l:T 'Deadline'}">
                <MenuItem Header="{l:T 'Vandaag'}" Tag="today" Click="Due_Click" />
                <MenuItem Header="{l:T 'Morgen'}" Tag="tomorrow" Click="Due_Click" />
                <MenuItem Header="{l:T 'Volgende week'}" Tag="nextweek" Click="Due_Click" />
                <MenuItem Header="{l:T 'Kies datum'}">
                    <MenuItem StaysOpenOnClick="True">
                        <MenuItem.Header>
                            <Calendar SelectedDatesChanged="Calendar_SelectedDatesChanged" />
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:T 'Geen deadline'}" Tag="none" Click="Due_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T 'Verwijderen'}" Click="Delete_Click" />
        </ContextMenu>

        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type local:TaskRow}">
            <Border x:Name="Row"
                    Padding="8,6,4,6" Margin="{Binding RowMargin}"
                    CornerRadius="6"
                    Background="Transparent"
                    ContextMenu="{StaticResource TaskMenu}"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown"
                    MouseMove="Row_MouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,1,10,0"
                              Focusable="False"
                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Click="Complete_Click" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PaneText}" />
                        <TextBox x:Name="Editor"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                 Style="{StaticResource PaneTextBox}"
                                 KeyDown="Editor_KeyDown"
                                 LostKeyboardFocus="Editor_LostKeyboardFocus"
                                 IsVisibleChanged="Editor_IsVisibleChanged" />
                        <TextBlock x:Name="DueText"
                                   Text="{Binding DueText}"
                                   FontSize="11"
                                   Margin="0,1,0,0"
                                   Foreground="{DynamicResource PaneMutedText}"
                                   Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="Star" Style="{StaticResource StarButton}" Click="ToggleImportant_Click"
                            VerticalAlignment="Top" Margin="0,-3,0,0"
                            Visibility="{Binding ShowStar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource PaneMutedText}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource PaneHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImportant}" Value="True">
                    <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource PaneAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource PaneOverdue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Star" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nieuwe taak -->
        <Grid Margin="10,10,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Verversen: alleen bij een bron die van buiten kan veranderen (niet bij lokale taken). -->
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource GlyphButton}" Margin="4,0,0,0" Height="32" Width="32"
                    ToolTip="{l:T 'Nu verversen'}" Visibility="Collapsed" Click="Refresh_Click" Content="&#xE72C;" FontSize="13" />

            <TextBox x:Name="NewTaskBox" Style="{StaticResource PaneTextBox}" Padding="28,6,8,6" KeyDown="NewTaskBox_KeyDown" />
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                       IsHitTestVisible="False" Foreground="{DynamicResource PaneMutedText}" />
            <TextBlock Text="{l:T 'Nieuwe taak toevoegen'}"
                       Margin="33,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource PaneMutedText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=NewTaskBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0,6,10">
                <ItemsControl x:Name="OpenList"
                              ItemTemplate="{StaticResource TaskTemplate}"
                              Background="Transparent"
                              AllowDrop="True"
                              DragOver="OpenList_DragOver"
                              Drop="OpenList_Drop" />

                <TextBlock x:Name="EmptyHint"
                           Margin="10,8"
                           Foreground="{DynamicResource PaneMutedText}"
                           Text="{l:T 'Geen open taken.'}" />

                <Expander x:Name="CompletedExpander" Margin="2,8,0,0" Foreground="{DynamicResource PaneMutedText}">
                    <ItemsControl x:Name="CompletedList" ItemTemplate="{StaticResource TaskTemplate}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Melding van de bron: geen verbinding, niet ingelogd, ... Verborgen als alles goed gaat. -->
        <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed" Padding="10,6"
                Background="#33000000">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource PaneOverdue}" />
        </Border>
    </Grid>
</UserControl>
